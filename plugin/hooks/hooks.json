{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__cua_repl__js$",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "KIP: Follow mouse use and block a chat paused by Esc",
            "command": "powershell.exe -NoProfile -NonInteractive -Command \"dotnet ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT') + '/bin/KIP.dll') --hook\"",
            "timeout": 4
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{
          "type": "command",
          "statusMessage": "KIP: Resume mouse use on explicit request",
          "command": "powershell.exe -NoProfile -NonInteractive -Command \"dotnet ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT') + '/bin/KIP.dll') --hook\"",
          "timeout": 4
        }]
      }
    ]
  }
}
