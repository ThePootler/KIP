{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__(cua_repl|node_repl)__js$",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "KIP: Follow mouse use and block a chat paused by Esc",
            "command": "powershell.exe -NoProfile -NonInteractive -Command \"& ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT') + '/bin/KIP.exe') --hook | Out-Host; exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
            "timeout": 4
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{
          "type": "command",
          "statusMessage": "KIP: Resume mouse use on explicit request",
          "command": "powershell.exe -NoProfile -NonInteractive -Command \"& ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT') + '/bin/KIP.exe') --hook | Out-Host; exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
          "timeout": 4
        }]
      }
    ]
  }
}
