{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__cua_repl__js$",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "KIP: Follow mouse use and block a chat paused by Esc",
            "command": "python -B -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'signal.py'),run_name='__main__')\"",
            "timeout": 4
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{
          "type": "command",
          "statusMessage": "KIP: Resume mouse use on Ian's explicit request",
          "command": "python -B -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'signal.py'),run_name='__main__')\"",
          "timeout": 4
        }]
      }
    ]
  }
}
